<Project Sdk="WixToolset.Sdk/4.0.5">

  <PropertyGroup>
    <OutputType>Package</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.5" />
    <!-- WiX v4 ne fournit pas l'élément <Files> de récolte de dossier (arrivé en v5) : on passe par
         Heat (HarvestDirectory), l'équivalent stable pour cette version, qui génère un fragment
         ComponentGroup "AppFiles" à partir du contenu de PublishDir (fourni en ligne de commande par
         la CI : dotnet build AgySize.Installer.wixproj -p:PublishDir=<dossier publié de AgySize.App>). -->
    <PackageReference Include="WixToolset.Heat" Version="4.0.5" />
  </ItemGroup>

  <ItemGroup>
    <HarvestDirectory Include="$(PublishDir)">
      <ComponentGroupName>AppFiles</ComponentGroupName>
      <DirectoryRefId>INSTALLFOLDER</DirectoryRefId>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>
    <BindPath Include="$(PublishDir)" />
  </ItemGroup>

</Project>
