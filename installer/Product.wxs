<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="AGY-Size"
           Manufacturer="AGYTEK"
           Version="1.0.0"
           UpgradeCode="9f0c9c9a-6d0a-4a8b-9a8f-5a1b8a5b7a11"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="Une version plus récente d'AGY-Size est déjà installée." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AGY-Size" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="AGY-Size" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="AGY-Size" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="AutoStartRegistry" />
    </Feature>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder" Guid="2b1b0a63-6a3d-4e0a-9d0e-1a2c3d4e5f60">
      <Shortcut Id="AppStartMenuShortcut"
                Name="AGY-Size"
                Description="Espace disque, droits d'accès et journal"
                Target="[INSTALLFOLDER]AgySize.App.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\AGYTEK\AGY-Size" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Démarrage automatique avec Windows (clé Run de l'utilisateur courant, cf. AutoStartManager
         côté application, qui permet aussi de désactiver ce comportement depuis l'interface). -->
    <Component Id="AutoStartRegistry" Directory="INSTALLFOLDER" Guid="7c9e2f4a-1a2b-4c3d-8e9f-0a1b2c3d4e5f">
      <RegistryValue Root="HKCU"
                     Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="AGY-Size"
                     Type="string"
                     Value="&quot;[INSTALLFOLDER]AgySize.App.exe&quot; --minimized"
                     KeyPath="yes" />
    </Component>

  </Package>
</Wix>
